[Desktop Entry]
Type=Application
Name=Launch ATHENA
Comment=Double-click to start the Clinical Intelligence Workspace
Exec=bash -c 'cd "$HOME/Projects/ATHENA" 2>/dev/null || cd "$HOME/Projects/MissionATHENA" 2>/dev/null; ./launch.sh'
Icon=utilities-system-monitor
Terminal=false
Categories=Science;Medical;Development;
