# ==============================================================================
# A.T.H.E.N.A. — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local/production deployment.
# NEVER commit .env to version control.

# Application Environment
ATHENA_ENV=production
ATHENA_LOG_LEVEL=INFO
ATHENA_HOST=0.0.0.0
ATHENA_PORT=8000

# Security & Encryption (Generate via: python3 -c 'import secrets; print(secrets.token_hex(32))')
ATHENA_ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key
ATHENA_JWT_SECRET=replace_with_secure_jwt_secret_token
ATHENA_API_KEY=replace_with_admin_api_key

# Statistical R Engine
ATHENA_R_API_URL=http://localhost:8001
ATHENA_R_BIND_HOST=127.0.0.1

# Database Backend (SQLite for single-node / PostgreSQL for distributed)
ATHENA_DATABASE_URL=sqlite:///athena.db
# ATHENA_DATABASE_URL=postgresql://athena_user:secure_password@localhost:5432/athena_db

# Message Broker & Cache (Optional: Synchronous fallback active when absent)
ATHENA_REDIS_URL=redis://localhost:6379/0

# Thermal & Hardware Safety Guard
ATHENA_THERMAL_THROTTLE_TEMP=85.0
ATHENA_THERMAL_CRITICAL_TEMP=92.0
